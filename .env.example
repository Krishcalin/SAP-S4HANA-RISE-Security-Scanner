# Copy to .env and fill in. Never commit .env.
#
# SESSION_SECRET has no default on purpose: a deployment that forgets it must
# fail at startup rather than silently run on a value published in this repo.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
POSTGRES_PASSWORD=change_me_before_first_run
DB_DSN=postgresql://sapsec:change_me_before_first_run@db:5432/sapsec
UPLOAD_DIR=/var/lib/sapsec/uploads
MAX_UPLOAD_BYTES=268435456
MAX_CONCURRENT_SCANS=2
