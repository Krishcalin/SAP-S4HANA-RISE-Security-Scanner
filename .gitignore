# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
env/
.venv/
.env/

# Secrets. `.env` holds SESSION_SECRET and POSTGRES_PASSWORD. Note the pattern above
# is `.env/` — a DIRECTORY — and does not match the file, which is exactly how a
# secret gets committed by accident. `.env.example` is the template and is tracked.
.env
!.env.example
*.pem
*.key

# Server runtime state — uploaded bundles are a customer's SAP configuration
var/
uploads/

# Test caches
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Scan outputs (don't commit real reports)
*.html
!sample_data/sample_report.html
# The console's Jinja2 templates are SOURCE, not scan output. Without this the
# blanket *.html above silently drops the entire web tier from the repo.
!server/templates/
!server/templates/*.html
*.pdf
!docs/*.pdf
sample_report.*

# Real export data (never commit production SAP exports)
exports/
real_data/
production/
*.bak

# Jupyter
.ipynb_checkpoints/
